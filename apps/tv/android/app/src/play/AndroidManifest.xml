<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Google Play updates the app, so it can't install packages itself. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" tools:node="remove" />
    <!-- Play reviews "display over other apps" closely; the Play build opens itself at start-up only on Android 9 and older. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" tools:node="remove" />

    <application>
      <provider
        android:name="androidx.core.content.FileProvider"
        android:authorities="${applicationId}.updates"
        tools:node="remove" />
    </application>
</manifest>
