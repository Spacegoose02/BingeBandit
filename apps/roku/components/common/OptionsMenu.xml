<?xml version="1.0" encoding="utf-8"?>
<!-- A side panel of choices (the player's audio and subtitles, the guide's options). Back closes it. -->
<component name="OptionsMenu" extends="Group">
  <interface>
    <field id="title" type="string" onChange="onTitle" />
    <!-- A line under the title: what a choice did, or a hint. -->
    <field id="message" type="string" onChange="onMessage" />
    <!-- The labels to choose from. -->
    <field id="options" type="stringarray" onChange="onOptions" />
    <!-- The option focused when the list is shown. -->
    <field id="focus" type="integer" />
    <field id="chosen" type="integer" alwaysNotify="true" />
    <field id="closed" type="boolean" alwaysNotify="true" />
  </interface>
  <children>
    <Rectangle width="1920" height="1080" color="0x00000080" />
    <Rectangle width="760" height="1080" translation="[1160, 0]" color="0x14181DFF" />
    <Label id="title" width="640" translation="[1220, 70]" wrap="true" maxLines="2" color="0xF2F4F7FF">
      <Font role="font" uri="pkg:/fonts/Inter-Bold.otf" size="40" />
    </Label>
    <Label id="message" width="640" translation="[1220, 180]" wrap="true" maxLines="3" color="0x2DD4BFFF">
      <Font role="font" uri="pkg:/fonts/Inter-Regular.otf" size="26" />
    </Label>
    <LabelList id="list" translation="[1200, 300]" itemSize="[680, 70]" itemSpacing="[0, 8]" numRows="9" vertFocusAnimationStyle="floatingFocus"
      color="0xF2F4F7FF" focusedColor="0xF2F4F7FF" focusBitmapUri="pkg:/images/focus.9.png" focusFootprintBitmapUri="pkg:/images/tile.9.png">
      <Font role="font" uri="pkg:/fonts/Inter-Regular.otf" size="30" />
      <Font role="focusedFont" uri="pkg:/fonts/Inter-Bold.otf" size="30" />
    </LabelList>
    <Label text="Back closes this" width="640" translation="[1220, 1010]" color="0x98A1ADFF">
      <Font role="font" uri="pkg:/fonts/Inter-Regular.otf" size="22" />
    </Label>
  </children>
  <script type="text/brightscript" uri="pkg:/components/common/OptionsMenu.brs" />
</component>
