<?xml version="1.0" encoding="utf-8"?>
<!-- A 4 to 8 digit PIN pad (the built-in PinDialog only takes 4). Sets `pin` on OK, `cancel` on Back. -->
<component name="PinEntry" extends="Group">
  <interface>
    <field id="title" type="string" onChange="onTitle" />
    <field id="error" type="string" alwaysNotify="true" onChange="onError" />
    <!-- Clears what was typed and puts focus on the first key. -->
    <field id="reset" type="boolean" alwaysNotify="true" onChange="onReset" />
    <field id="pin" type="string" alwaysNotify="true" />
    <field id="cancel" type="boolean" alwaysNotify="true" />
  </interface>
  <children>
    <Label id="title" width="1920" translation="[0, 120]" horizAlign="center" color="0xF2F4F7FF">
      <Font role="font" uri="pkg:/fonts/Inter-Bold.otf" size="56" />
    </Label>
    <Label id="dots" width="1920" translation="[0, 220]" horizAlign="center" color="0xF2F4F7FF">
      <Font role="font" uri="pkg:/fonts/Inter-Bold.otf" size="64" />
    </Label>
    <Label id="error" width="1920" translation="[0, 310]" horizAlign="center" color="0xF87171FF">
      <Font role="font" uri="pkg:/fonts/Inter-Regular.otf" size="30" />
    </Label>
    <MarkupGrid id="keys" vertFocusAnimationStyle="floatingFocus" itemComponentName="KeyItem" itemSize="[150, 100]" itemSpacing="[24, 24]" numColumns="3" numRows="4" translation="[715, 390]" drawFocusFeedback="true" focusBitmapUri="pkg:/images/focus.9.png" />
    <Label text="Back to cancel" width="1920" translation="[0, 920]" horizAlign="center" color="0x98A1ADFF">
      <Font role="font" uri="pkg:/fonts/Inter-Regular.otf" size="26" />
    </Label>
  </children>
  <script type="text/brightscript" uri="pkg:/components/common/PinEntry.brs" />
</component>
