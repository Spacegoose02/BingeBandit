<?xml version="1.0" encoding="utf-8"?>
<!-- A key on the PIN pad. -->
<component name="KeyItem" extends="Group">
  <interface>
    <field id="itemContent" type="node" onChange="onContent" />
  </interface>
  <children>
    <Rectangle id="bg" width="150" height="100" color="0x262C35FF">
      <Label id="label" width="150" height="100" horizAlign="center" vertAlign="center" color="0xF2F4F7FF">
        <Font role="font" uri="pkg:/fonts/Inter-Bold.otf" size="40" />
      </Label>
    </Rectangle>
  </children>
  <script type="text/brightscript" uri="pkg:/components/items/KeyItem.brs" />
</component>
