<?xml version="1.0" encoding="utf-8"?>
<!-- The main screen: a menu on the left (Home, Search, libraries, Live TV...) and the chosen panel beside it. -->
<component name="HomeScreen" extends="BaseScreen">
  <children>
    <Poster id="backdrop" width="1920" height="1080" loadDisplayMode="scaleToZoom" opacity="0.25" />
    <Rectangle width="1920" height="1080" color="0x0B0D10A0" />
    <Rectangle width="360" height="1080" color="0x14181DF0" />
    <Poster uri="pkg:/images/logo.png" width="260" height="66" translation="[50, 50]" />
    <Label id="who" width="280" translation="[50, 132]" color="0x98A1ADFF">
      <Font role="font" uri="pkg:/fonts/Inter-Regular.otf" size="24" />
    </Label>
    <LabelList id="menu" translation="[30, 200]" itemSize="[300, 66]" itemSpacing="[0, 6]" numRows="12" vertFocusAnimationStyle="floatingFocus"
      color="0x98A1ADFF" focusedColor="0xF2F4F7FF" focusBitmapUri="pkg:/images/focus.9.png">
      <Font role="font" uri="pkg:/fonts/Inter-Regular.otf" size="32" />
      <Font role="focusedFont" uri="pkg:/fonts/Inter-Bold.otf" size="32" />
    </LabelList>
    <Group id="views" translation="[400, 0]" />
    <Timer id="switchTimer" duration="0.35" repeat="false" />
  </children>
  <script type="text/brightscript" uri="pkg:/components/common/util.brs" />
  <script type="text/brightscript" uri="pkg:/components/screens/HomeScreen.brs" />
</component>
